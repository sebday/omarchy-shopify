#!/usr/bin/bash
# Small JSON for the panel: poll minutes and theme colours.
# Reads two fixed paths. The last path component is not followed if it is a symlink.
set -euo pipefail

read_file() {
  local file=$1 max=$2 out n
  out=$(/usr/bin/dd if="$file" iflag=nofollow,nonblock,count_bytes,fullblock bs=1 count=$((max + 1)) status=none 2>/dev/null) || return 1
  n=$(printf '%s' "$out" | /usr/bin/wc -c | /usr/bin/awk '{print $1}')
  [[ "$n" =~ ^[0-9]+$ ]] || return 1
  [[ "$n" -le "$max" ]] || return 1
  printf '%s' "$out"
}

state="${XDG_STATE_HOME:-$HOME/.local/state}"
theme="$state/omarchy/current/theme/colors.toml"
shell_cfg="${OMARCHY_SHELL_CONFIG:-$HOME/.config/omarchy/shell.json}"

mins=5
cfg=""
if cfg=$(read_file "$shell_cfg" 262144); then
  parsed=$(printf '%s' "$cfg" | /usr/bin/jq -er 'if (.shopify.pollIntervalMinutes | type) == "number" and .shopify.pollIntervalMinutes >= 1 and .shopify.pollIntervalMinutes <= 1440 then (.shopify.pollIntervalMinutes | floor) else empty end' 2>/dev/null || true)
  case "$parsed" in
    ''|*[!0-9]*) ;;
    *) mins=$parsed ;;
  esac
fi

cyan=""
bright_green=""
blue=""
yellow=""
magenta=""
muted=""
foreground=""
bright_foreground=""
background=""

raw=""
if raw=$(read_file "$theme" 16384); then
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      ''|\#*) continue ;;
    esac
    key=${line%%=*}
    val=${line#*=}
    key=${key#"${key%%[![:space:]]*}"}
    key=${key%"${key##*[![:space:]]}"}
    val=${val#"${val%%[![:space:]]*}"}
    val=${val%\"}
    val=${val#\"}
    val=${val%"${val##*[![:space:]]}"}
    case "$key" in
      cyan|bright_green|blue|yellow|magenta|muted|foreground|bright_foreground|background) ;;
      *) continue ;;
    esac
    case "$val" in
      \#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;;
      *) continue ;;
    esac
    case "$key" in
      cyan) cyan=$val ;;
      bright_green) bright_green=$val ;;
      blue) blue=$val ;;
      yellow) yellow=$val ;;
      magenta) magenta=$val ;;
      muted) muted=$val ;;
      foreground) foreground=$val ;;
      bright_foreground) bright_foreground=$val ;;
      background) background=$val ;;
    esac
  done <<<"$raw"
fi

/usr/bin/jq -n \
  --argjson mins "$mins" \
  --arg cyan "$cyan" \
  --arg bright_green "$bright_green" \
  --arg blue "$blue" \
  --arg yellow "$yellow" \
  --arg magenta "$magenta" \
  --arg muted "$muted" \
  --arg foreground "$foreground" \
  --arg bright_foreground "$bright_foreground" \
  --arg background "$background" \
  '{pollIntervalMinutes: $mins, colors: {
    cyan: $cyan,
    bright_green: $bright_green,
    blue: $blue,
    yellow: $yellow,
    magenta: $magenta,
    muted: $muted,
    foreground: $foreground,
    bright_foreground: $bright_foreground,
    background: $background
  }}'
