#!/bin/bash
# Shopify KPI JSON for evo.shopify Omarchy bar widget.
# Reads merged KPI rows from ecommerce-data SQLite (fact_kpi_daily).
#
# Config (shell.json shopify block):
#   dataPath  — host:dir or user@host:dir (remote, default) or local path
#   timezone, stores

set -euo pipefail

_bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "${_bin_dir}/common.sh"

merged_config() { cat "${OMARCHY_SHELL_CONFIG:-$HOME/.config/omarchy/shell.json}" 2>/dev/null || echo '{}'; }

DEFAULT_TZ="Europe/London"
DEFAULT_DATA_PATH="zotac:~/projects/ecommerce-data/data"
DATA_PATH=""
DATA_MODE=""       # local | remote
DATA_LOCAL=""      # absolute local data dir
DATA_SSH=""        # user@host
DATA_REMOTE_DIR="" # path on remote host

STORES=()

declare -gA REMOTE_KPI=()
REMOTE_RAW_TODAY=""
REMOTE_CURRENCY=""
REMOTE_LATEST_DATE=""
REMOTE_MTD=""
REMOTE_HAS_SPEND=0
REMOTE_ERROR=""
EMPTY_KPI="0|0|0||||0|0|0|0"

discover_stores_from_names() {
    local name key display
    STORES=()
    for name in "$@"; do
        [[ -z "$name" || "$name" == "default" ]] && continue
        key=$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')
        display="${key} "
        STORES+=("${key}|${display}|${name}")
    done
    ((${#STORES[@]} > 0))
}

discover_stores_local() {
    local base=$1 f name
    [[ -d "$base" ]] || return 1
    local -a names=()
    shopt -s nullglob
    for f in "$base"/*.sqlite; do
        names+=("$(basename "$f" .sqlite)")
    done
    shopt -u nullglob
    discover_stores_from_names "${names[@]}"
}

discover_stores_remote() {
    local listing
    listing=$(evo_ssh_run "$DATA_SSH" "for f in ${DATA_REMOTE_DIR%/}/*.sqlite; do [[ -f \"\$f\" ]] && basename \"\$f\" .sqlite; done" 2>/dev/null) || return 1
    local -a names=()
    while IFS= read -r name; do
        [[ -n "$name" ]] && names+=("$name")
    done <<< "$listing"
    discover_stores_from_names "${names[@]}"
}

resolve_data_path() {
    local cfg data_path
    cfg="$(merged_config | jq -c '.shopify // {}')"
    DEFAULT_TZ="$(jq -r '.timezone // "Europe/London"' <<<"$cfg")"
    data_path="$(jq -r '.dataPath // ""' <<<"$cfg")"
    data_path="${data_path// /}"
    [[ -n "$data_path" ]] || data_path="$DEFAULT_DATA_PATH"

    DATA_PATH="$data_path"
    DATA_MODE=""
    DATA_LOCAL=""
    DATA_SSH=""
    DATA_REMOTE_DIR=""

    if [[ "$DATA_PATH" =~ ^([^@]+)@([^:]+):(.+)$ ]]; then
        DATA_MODE=remote
        DATA_SSH="${BASH_REMATCH[1]}@${BASH_REMATCH[2]}"
        DATA_REMOTE_DIR="${BASH_REMATCH[3]}"
    elif [[ "$DATA_PATH" =~ ^([^:@]+):(.+)$ ]]; then
        DATA_MODE=remote
        DATA_SSH="${BASH_REMATCH[1]}"
        DATA_REMOTE_DIR="${BASH_REMATCH[2]}"
    else
        DATA_MODE=local
        DATA_LOCAL="$(readlink -f "${DATA_PATH/#\~/$HOME}")"
        return 0
    fi

    DATA_REMOTE_DIR="$(evo_resolve_remote_dir "$DATA_SSH" "$DATA_REMOTE_DIR")" || return 1
}

load_shopify_config() {
    STORES=()
    resolve_data_path || return 0
    if [[ "$DATA_MODE" == local ]]; then
        discover_stores_local "$DATA_LOCAL" || true
    elif [[ "$DATA_MODE" == remote ]]; then
        discover_stores_remote || true
    fi
}

config_data_path() {
    local data_path
    data_path="$(merged_config | jq -r '.shopify.dataPath // ""')"
    data_path="${data_path// /}"
    [[ -n "$data_path" ]] || data_path="$DEFAULT_DATA_PATH"
    printf '%s' "$data_path"
}

cache_key_slug() {
    printf '%s' "$(config_data_path)" | tr '/:@~ ' '_'
}

snapshot_cache_key() {
    printf 'shopify-%s-snapshot' "$(cache_key_slug)"
}

store_cache_key() {
    printf 'shopify-%s-%s-%s' "$(cache_key_slug)" "${1:-all}" "$2"
}

json_text() {
    jq -cn --arg text "$1" '{text: $text}'
}

payload_is_ok() {
    jq -e '((.bars // []) | length) > 0 or ((.todayDetail.date // "") | length) > 0' <<<"$1" >/dev/null 2>&1
}

json_shopify() {
    jq -cn \
        --arg text "$1" \
        --arg label "$2" \
        --argjson bars "$3" \
        --arg symbol "$4" \
        --argjson orders "$5" \
        --arg cos "$6" \
        --argjson revenue "$7" \
        --argjson todayDetail "$8" \
        --argjson period "$9" \
        --argjson channels "${10}" \
        --argjson orderBars "${11}" \
        --argjson month "${12}" \
        --argjson sessionBars "${13}" \
        --argjson spendBars "${14}" \
        --argjson cvrBars "${15}" \
        --argjson aovBars "${16}" \
        --argjson cosBars "${17}" \
        '{
            text: $text,
            label: $label,
            bars: $bars,
            symbol: $symbol,
            orders: $orders,
            cos: $cos,
            revenue: $revenue,
            todayDetail: $todayDetail,
            period: $period,
            channels: $channels,
            orderBars: $orderBars,
            month: $month,
            sessionBars: $sessionBars,
            spendBars: $spendBars,
            cvrBars: $cvrBars,
            aovBars: $aovBars,
            cosBars: $cosBars
        }'
}

site_sqlite_path() {
    local site_key=$1
    local safe base
    safe=$(printf '%s' "$site_key" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/_/g')
    if [[ "$DATA_MODE" == remote ]]; then
        base="${DATA_REMOTE_DIR%/}"
    else
        base="${DATA_LOCAL%/}"
    fi
    printf '%s/%s.sqlite' "$base" "$safe"
}

remote_fetch_store_data() {
    local db=$1 today_s=$2 start_date=$3 month_start=$4
    local output line tag rest dt attempt

    evo_valid_date "$today_s" || return 1
    evo_valid_date "$start_date" || return 1
    evo_valid_date "$month_start" || return 1

    for attempt in 1 2 3; do
        REMOTE_KPI=()
        REMOTE_RAW_TODAY=""
        REMOTE_CURRENCY=""
        REMOTE_LATEST_DATE=""
        REMOTE_MTD=""
        REMOTE_HAS_SPEND=0
        REMOTE_ERROR=""

        if ! output=$(evo_ssh_run "$DATA_SSH" bash -s -- \
            "$(printf '%q' "$db")" \
            "$(printf '%q' "$today_s")" \
            "$(printf '%q' "$start_date")" \
            "$(printf '%q' "$month_start")" <<'REMOTE'
set -euo pipefail
db=$1
today=$2
start=$3
month_start=$4
SQLITE=(sqlite3 -readonly -cmd ".timeout 10000")

if ! command -v sqlite3 >/dev/null 2>&1; then
  echo "ERROR|sqlite3 not found on remote host"
  exit 0
fi
if [[ ! -f "$db" ]]; then
  echo "ERROR|database not found"
  exit 0
fi

spend_col="NULL"
if "${SQLITE[@]}" "$db" "PRAGMA table_info(fact_kpi_daily)" | cut -d'|' -f2 | grep -qx 'google_spend'; then
  spend_col="google_spend"
  echo "HAS_SPEND|1"
else
  echo "HAS_SPEND|0"
fi

currency=$("${SQLITE[@]}" "$db" "SELECT COALESCE(currency_code, '') FROM raw_shopify_orders_daily WHERE dt = '${today}';" 2>/dev/null || true)
echo "CURRENCY|${currency}"

latest=$("${SQLITE[@]}" "$db" "SELECT dt FROM fact_kpi_daily WHERE dt <= '${today}' AND (COALESCE(revenue, 0) > 0 OR COALESCE(orders, 0) > 0 OR COALESCE(sessions, 0) > 0) ORDER BY dt DESC LIMIT 1;" 2>/dev/null || true)
echo "LATEST|${latest}"

mtd=$("${SQLITE[@]}" "$db" "SELECT COALESCE(SUM(revenue), 0) FROM fact_kpi_daily WHERE dt >= '${month_start}' AND dt <= '${today}';" 2>/dev/null || true)
echo "MTD|${mtd}"

"${SQLITE[@]}" -separator '|' "$db" \
  "SELECT dt, COALESCE(revenue,0), COALESCE(orders,0), COALESCE(sessions,0), ${spend_col}, cvr, COALESCE(paid_revenue,0), COALESCE(organic_revenue,0), COALESCE(direct_revenue,0), COALESCE(email_revenue,0) FROM fact_kpi_daily WHERE dt >= '${start}' AND dt <= '${today}';" \
  | while IFS='|' read -r dt rev orders sessions spend cvr paid org direct email; do
      [[ -n "$dt" ]] || continue
      printf 'KPI|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
        "$dt" "${rev:-0}" "${orders:-0}" "${sessions:-0}" "${spend:-}" "${cvr:-}" \
        "${paid:-0}" "${org:-0}" "${direct:-0}" "${email:-0}"
    done

raw=$("${SQLITE[@]}" -separator '|' "$db" \
  "SELECT COALESCE(gross_revenue, 0), COALESCE(order_count, 0), COALESCE(shopify_sessions, 0) FROM raw_shopify_orders_daily WHERE dt = '${today}';" 2>/dev/null \
  || printf '0|0|0')
echo "RAW|${today}|${raw}"
REMOTE
        ); then
            REMOTE_ERROR="ssh query failed"
            (( attempt < 3 )) && sleep 1
            continue
        fi

        while IFS= read -r line; do
            [[ -n "$line" ]] || continue
            tag="${line%%|*}"
            rest="${line#*|}"
            case "$tag" in
                ERROR)
                    REMOTE_ERROR="$rest"
                    echo "shopify-status: remote: ${rest}" >&2
                    return 1
                    ;;
                HAS_SPEND)
                    [[ "$rest" == "1" ]] && REMOTE_HAS_SPEND=1
                    ;;
                CURRENCY)
                    REMOTE_CURRENCY="$rest"
                    ;;
                LATEST)
                    REMOTE_LATEST_DATE="$rest"
                    ;;
                MTD)
                    REMOTE_MTD="$rest"
                    ;;
                KPI)
                    dt="${rest%%|*}"
                    REMOTE_KPI["$dt"]="${rest#*|}"
                    ;;
                RAW)
                    REMOTE_RAW_TODAY="${rest#*|}"
                    ;;
            esac
        done <<< "$output"
        return 0
    done

    return 1
}

has_google_spend_column() {
    local db=$1
    if [[ "$DATA_MODE" == remote ]]; then
        (( REMOTE_HAS_SPEND == 1 ))
        return
    fi
    sqlite3 -readonly "$db" "PRAGMA table_info(fact_kpi_daily)" | cut -d'|' -f2 | grep -qx 'google_spend' || return 1
}

get_day_kpi() {
    local db=$1 dt=$2 spend_col=$3
    if [[ "$DATA_MODE" == remote ]]; then
        printf '%s\n' "${REMOTE_KPI[$dt]:-$EMPTY_KPI}"
        return
    fi
    sqlite3 -readonly -separator '|' "$db" \
        "SELECT COALESCE(revenue,0), COALESCE(orders,0), COALESCE(sessions,0), ${spend_col}, cvr, COALESCE(paid_revenue,0), COALESCE(organic_revenue,0), COALESCE(direct_revenue,0), COALESCE(email_revenue,0) FROM fact_kpi_daily WHERE dt = '${dt}';" 2>/dev/null \
        || printf '%s\n' "$EMPTY_KPI"
}

get_month_mtd_revenue() {
    local db=$1 month_start=$2 today=$3
    if [[ "$DATA_MODE" == remote ]]; then
        printf '%s' "${REMOTE_MTD:-0}"
        return
    fi
    sqlite3 -readonly "$db" \
        "SELECT COALESCE(SUM(revenue), 0) FROM fact_kpi_daily WHERE dt >= '${month_start}' AND dt <= '${today}';" 2>/dev/null \
        || printf '0'
}

kpi_day_has_data() {
    local rev=$1 orders=$2 sessions=$3
    awk -v r="${rev:-0}" -v o="${orders:-0}" -v s="${sessions:-0}" 'BEGIN {
        exit !((r + 0) > 0 || (o + 0) > 0 || (s + 0) > 0)
    }'
}

get_latest_kpi_date() {
    local db=$1 max_dt=$2
    if [[ "$DATA_MODE" == remote ]]; then
        printf '%s' "$REMOTE_LATEST_DATE"
        return
    fi
    sqlite3 -readonly "$db" \
        "SELECT dt FROM fact_kpi_daily
         WHERE dt <= '${max_dt}'
           AND (COALESCE(revenue, 0) > 0 OR COALESCE(orders, 0) > 0 OR COALESCE(sessions, 0) > 0)
         ORDER BY dt DESC
         LIMIT 1;" 2>/dev/null || true
}

get_raw_shopify_day() {
    local db=$1 dt=$2
    if [[ "$DATA_MODE" == remote ]]; then
        printf '%s\n' "${REMOTE_RAW_TODAY:-0|0|0}"
        return
    fi
    sqlite3 -readonly -separator '|' "$db" \
        "SELECT COALESCE(gross_revenue, 0), COALESCE(order_count, 0), COALESCE(shopify_sessions, 0)
         FROM raw_shopify_orders_daily
         WHERE dt = '${dt}';" 2>/dev/null \
        || printf '0|0|0'
}

get_currency_code() {
    local db=$1 today_s=$2
    if [[ "$DATA_MODE" == remote ]]; then
        printf '%s' "$REMOTE_CURRENCY"
        return
    fi
    sqlite3 -readonly "$db" \
        "SELECT currency_code FROM raw_shopify_orders_daily WHERE dt = '${today_s}';" 2>/dev/null || true
}

currency_symbol() {
    local code="${1:-}"
    code=$(printf '%s' "$code" | tr '[:lower:]' '[:upper:]' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    case "$code" in
        "" | GBP) printf '£' ;;
        USD)      printf '$' ;;
        EUR)      printf '€' ;;
        *)        printf '%s ' "$code" ;;
    esac
}

format_int_commas() {
    awk -v n="$1" 'BEGIN {
        s = sprintf("%d", n + 0)
        len = length(s)
        out = ""
        for (i = 1; i <= len; i++) {
            c = substr(s, len - i + 1, 1)
            if (i > 1 && (i - 1) % 3 == 0) out = "," out
            out = c out
        }
        print out
    }'
}

build_sparkline_json() {
    local -a rows=("$@")
    local max_sale row day_iso sale bar_level color_level color

    max_sale=$(printf '%s\n' "${rows[@]}" | awk -F'|' '
        { v = ($2 == "" ? 0 : $2 + 0); if (v < 0) v = 0; if (v > max) max = v }
        END { print max + 0 }
    ')

    if awk -v m="$max_sale" 'BEGIN { exit (m == 0) ? 0 : 1 }'; then
        printf '[]'
        return
    fi

    local lines=""
    for row in "${rows[@]}"; do
        IFS='|' read -r day_iso sale ord <<< "$row"
        read -r bar_level color_level <<< "$(awk -v sale="$sale" -v max="$max_sale" 'BEGIN {
            s = (sale == "" ? 0 : sale + 0)
            if (s < 0) s = 0

            bar_level = 0
            if (s > 0) {
                bar_level = int((s / max) * 7)
                if (bar_level == 0) bar_level = 1
            }
            if (bar_level > 7) bar_level = 7

            color_level = 0
            if (s > 0) {
                pct = s / max
                if (pct > 0.75) color_level = 4
                else if (pct > 0.5) color_level = 3
                else if (pct > 0.25) color_level = 2
                else color_level = 1
            }

            print bar_level, color_level
        }')"
        color="${GITHUB_COLORS[$color_level]}"
        lines+="$(jq -cn --arg date "$day_iso" --argjson value "${sale:-0}" --argjson orders "${ord:-0}" \
            --argjson level "$bar_level" --argjson colorLevel "$color_level" --arg color "$color" \
            '{date: $date, value: $value, orders: $orders, level: $level, colorLevel: $colorLevel, color: $color}')"
        lines+=$'\n'
    done

    printf '%s' "$lines" | jq -s '.'
}

find_store() {
    local want_prefix=$1
    local entry prefix display site_key
    for entry in "${STORES[@]}"; do
        IFS='|' read -r prefix display site_key <<< "$entry"
        if [[ "$prefix" == "$want_prefix" ]]; then
            STORE_PREFIX=$prefix
            STORE_DISPLAY=$display
            STORE_SITE_KEY=$site_key
            return 0
        fi
    done
    return 1
}

data_path_ready() {
    case "$DATA_MODE" in
        local)
            [[ -n "$DATA_LOCAL" && -d "$DATA_LOCAL" ]]
            ;;
        remote)
            [[ -n "$DATA_SSH" && -n "$DATA_REMOTE_DIR" ]]
            ;;
        *)
            false
            ;;
    esac
}

EMPTY_SNAPSHOT='{"stores":[],"payloads":{}}'
SNAPSHOT_DAYS=30
CACHE_TTL_SEC=300

snapshot_with_icons() {
    local snap=$1
    local stores payloads store sqlite_key icon new_stores
    stores=$(jq -c '.stores // []' <<<"$snap")
    payloads=$(jq -c '.payloads // {}' <<<"$snap")
    new_stores='[]'
    while IFS= read -r store; do
        [[ -n "$store" ]] || continue
        sqlite_key=$(jq -r '.sqliteKey // (.key | ascii_downcase)' <<<"$store")
        icon=$(evo_resolve_icon_path "$sqlite_key" "${DATA_LOCAL:-}" 2>/dev/null || true)
        new_stores=$(jq -c --argjson s "$store" --arg icon "$icon" '. + [$s + {iconPath: $icon}]' <<<"$new_stores")
    done < <(jq -c '.[]' <<<"$stores")
    jq -c --argjson stores "$new_stores" '{stores: $stores, payloads: .}' <<<"$payloads"
}

cache_favicons() {
    local listing remote_file dest base
    mkdir -p "$EVO_SHOPIFY_ICON_DIR"
    if [[ "$DATA_MODE" == local ]]; then
        [[ -n "$DATA_LOCAL" && -d "$DATA_LOCAL" ]] || return 0
        shopt -s nullglob
        for dest in "${DATA_LOCAL%/}"/*.favicon.png; do
            cp -f "$dest" "$EVO_SHOPIFY_ICON_DIR/"
        done
        shopt -u nullglob
        return 0
    fi
    [[ "$DATA_MODE" == remote && -n "$DATA_SSH" && -n "$DATA_REMOTE_DIR" ]] || return 0
    listing=$(evo_ssh_run "$DATA_SSH" "ls ${DATA_REMOTE_DIR%/}/*.favicon.png 2>/dev/null" || true)
    while IFS= read -r remote_file; do
        [[ -n "$remote_file" ]] || continue
        base=$(basename "$remote_file")
        dest="${EVO_SHOPIFY_ICON_DIR}/${base}"
        scp "${EVO_SSH_OPTS[@]}" "${DATA_SSH}:${remote_file}" "$dest" >/dev/null 2>&1 || true
    done <<< "$listing"
}

cmd_cache() {
    local cached slug prefix f base key stores payloads_json one snapshot
    if cached=$(evo_bar_cache_read "$(snapshot_cache_key)" "$CACHE_TTL_SEC" 2>/dev/null); then
        snapshot_with_icons "$cached"
        return 0
    fi

    slug=$(cache_key_slug)
    prefix="shopify-${slug}-"
    stores='[]'
    payloads_json='{}'
    shopt -s nullglob
    for f in "${EVO_BAR_CACHE_DIR}/${prefix}"*-"${SNAPSHOT_DAYS}.json"; do
        base=$(basename "$f" ".json")
        key="${base#"$prefix"}"
        key="${key%-${SNAPSHOT_DAYS}}"
        [[ "$key" == "snapshot" || "$key" == "all" || -z "$key" ]] && continue
        one=$(cat "$f")
        [[ -n "$one" ]] || continue
        payload_is_ok "$one" || continue
        stores=$(jq -c --arg key "$key" --arg title "$key" --arg sqliteKey "$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')" \
            '. + [{key: $key, title: $title, adminSlug: "", sqliteKey: $sqliteKey}]' <<<"$stores")
        payloads_json=$(jq -c --arg k "$key" --argjson v "$one" '. + {($k): $v}' <<<"$payloads_json")
    done
    shopt -u nullglob

    if [[ "$stores" == "[]" ]]; then
        printf '%s\n' "$EMPTY_SNAPSHOT"
        return 0
    fi

    snapshot=$(snapshot_with_icons "$(jq -c --argjson stores "$stores" '{stores: $stores, payloads: .}' <<<"$payloads_json")")
    printf '%s\n' "$snapshot" | evo_bar_cache_write "$(snapshot_cache_key)"
    printf '%s\n' "$snapshot"
}

stores_json() {
    local entry prefix display site_key title admin_slug sqlite_key icon_path
    local -a lines=()
    local cfg_json cfg_count

    cfg_json="$(merged_config | jq -c '.shopify.stores // []')"
    cfg_count="$(jq -r 'length' <<<"$cfg_json")"

    if [[ "$cfg_count" -gt 0 ]]; then
        while IFS= read -r entry; do
            [[ -n "$entry" ]] || continue
            prefix="$(jq -r '.key // ""' <<<"$entry")"
            [[ -n "$prefix" ]] || continue
            title="$(jq -r '.title // .key // ""' <<<"$entry")"
            admin_slug="$(jq -r '.adminSlug // ""' <<<"$entry")"
            sqlite_key="$(jq -r '.sqliteKey // (.key | ascii_downcase)' <<<"$entry")"
            icon_path="$(evo_resolve_icon_path "$sqlite_key" "${DATA_LOCAL:-}" 2>/dev/null || true)"
            lines+=("$(jq -cn --arg key "$prefix" --arg title "$title" --arg adminSlug "$admin_slug" --arg sqliteKey "$sqlite_key" --arg iconPath "$icon_path" \
                '{key: $key, title: $title, adminSlug: $adminSlug, sqliteKey: $sqliteKey, iconPath: $iconPath}')")
        done < <(jq -c '.[]' <<<"$cfg_json")
    else
        if ((${#STORES[@]} == 0)) && data_path_ready; then
            if [[ "$DATA_MODE" == local ]]; then
                discover_stores_local "$DATA_LOCAL" || true
            else
                discover_stores_remote || true
            fi
        fi
        for entry in "${STORES[@]}"; do
            IFS='|' read -r prefix display site_key <<< "$entry"
            title="${display%% }"
            [[ -z "$title" ]] && title="$prefix"
            icon_path="$(evo_resolve_icon_path "$site_key" "${DATA_LOCAL:-}" 2>/dev/null || true)"
            lines+=("$(jq -cn --arg key "$prefix" --arg title "$title" --arg sqliteKey "$site_key" --arg iconPath "$icon_path" \
                '{key: $key, title: $title, adminSlug: "", sqliteKey: $sqliteKey, iconPath: $iconPath}')")
        done
    fi

    if ((${#lines[@]} == 0)); then
        printf '[]'
    else
        printf '%s\n' "${lines[@]}" | jq -s -c '.'
    fi
}

cmd_refresh() {
    local stores payloads_json key one snapshot
    load_shopify_config
    evo_bar_load_heatmap_colors

    if ! data_path_ready; then
        cmd_cache
        return 0
    fi

    cache_favicons
    stores=$(stores_json)
    payloads_json='{}'

    while IFS= read -r key; do
        [[ -n "$key" ]] || continue
        local prev=""
        if ! one=$(build_one_store "$key" "$SNAPSHOT_DAYS"); then
            [[ -n "$one" ]] || one=$(json_text "Error: Store ${key} not found")
            if prev=$(evo_bar_cache_read_any "$(store_cache_key "$key" "$SNAPSHOT_DAYS")" 2>/dev/null) && payload_is_ok "$prev"; then
                one="$prev"
            fi
        else
            printf '%s\n' "$one" | evo_bar_cache_write "$(store_cache_key "$key" "$SNAPSHOT_DAYS")"
        fi
        payloads_json=$(jq -c --arg k "$key" --argjson v "$one" '. + {($k): $v}' <<<"$payloads_json")
    done < <(jq -r '.[].key // empty' <<<"$stores")

    if [[ "$payloads_json" == "{}" && "$stores" == "[]" ]]; then
        cmd_cache
        return 0
    fi

    snapshot=$(snapshot_with_icons "$(jq -c --argjson stores "$stores" '{stores: $stores, payloads: .}' <<<"$payloads_json")")
    printf '%s\n' "$snapshot" | evo_bar_cache_write "$(snapshot_cache_key)"
    printf '%s\n' "$snapshot"
}

build_one_store() {
    local store_prefix=$1
    local days=$2
    local days_back output

    if ! [[ "$days" =~ ^[0-9]+$ ]] || (( days < 1 )); then
        days=14
    fi
    if (( days > 90 )); then
        days=90
    fi
    days_back=$((days - 1))

    local tz_name="${EVO_SHOPIFY_TZ:-$DEFAULT_TZ}"
    tz_name="${tz_name// /}"
    [[ -z "$tz_name" ]] && tz_name="$DEFAULT_TZ"

    evo_bar_load_heatmap_colors

    local today_s start_date month_start i day_iso db_path spend_col
    local rev orders sessions spend cvr paid_rev org_rev dir_rev email_rev
    local cos sym today_sales_val cos_str
    local period_rev period_orders period_sessions period_spend
    local period_paid period_organic period_direct period_email
    local prev_period_rev fetch_start
    local today_detail_json period_json sparkline_json
    local order_bars_json session_bars_json spend_bars_json
    local cvr_bars_json aov_bars_json cos_bars_json channels_json month_json
    local day_of_month days_in_month mtd_revenue forecast_revenue
    local -a chart_days=() chart_order_days=() chart_session_days=()
    local -a chart_spend_days=() chart_cvr_days=() chart_aov_days=() chart_cos_days=()

    today_s=$(TZ="$tz_name" date +%Y-%m-%d)
    start_date=$(TZ="$tz_name" date -d "${today_s} - ${days_back} days" +%Y-%m-%d)
    month_start=$(TZ="$tz_name" date -d "${today_s}" +%Y-%m-01)
    fetch_start="$start_date"
    if (( days >= 30 )); then
        fetch_start=$(TZ="$tz_name" date -d "${today_s} - 59 days" +%Y-%m-%d)
    fi

    if ! data_path_ready; then
        json_text "Shopify: set shopify.dataPath in shell.json"
        return 0
    fi

    if [[ -n "$store_prefix" ]]; then
        if ! find_store "$store_prefix"; then
            json_text "Error: Store ${store_prefix} not found"
            return 1
        fi
    else
        if ((${#STORES[@]} == 0)); then
            json_text "Shopify: no stores found"
            return 0
        fi
        IFS='|' read -r STORE_PREFIX STORE_DISPLAY STORE_SITE_KEY <<< "${STORES[0]}"
    fi

    db_path=$(site_sqlite_path "$STORE_SITE_KEY")

    if [[ "$DATA_MODE" == remote ]]; then
        if ! remote_fetch_store_data "$db_path" "$today_s" "$fetch_start" "$month_start"; then
            if [[ "$REMOTE_ERROR" == "database not found" ]]; then
                json_text "${STORE_DISPLAY}: no db (${db_path})"
            elif [[ -n "$REMOTE_ERROR" ]]; then
                json_text "${STORE_DISPLAY}: remote db error (${REMOTE_ERROR})"
            else
                json_text "${STORE_DISPLAY}: remote db error"
            fi
            return 1
        fi
    elif [[ ! -f "$db_path" ]] || ! sqlite3 -readonly "$db_path" "SELECT 1;" >/dev/null 2>&1; then
        json_text "${STORE_DISPLAY}: no db (${db_path})"
        return 1
    fi

    if has_google_spend_column "$db_path"; then
        spend_col="google_spend"
    else
        spend_col="NULL"
    fi

    period_rev=0
    period_orders=0
    period_sessions=0
    period_spend=0
    period_paid=0
    period_organic=0
    period_direct=0
    period_email=0

    for i in $(seq "$days_back" -1 0); do
        day_iso=$(TZ="$tz_name" date -d "${today_s} - ${i} days" +%Y-%m-%d)
        IFS='|' read -r rev orders sessions spend cvr paid_rev org_rev dir_rev email_rev <<< "$(get_day_kpi "$db_path" "$day_iso" "$spend_col")"
        rev=${rev:-0}
        orders=${orders:-0}
        sessions=${sessions:-0}
        chart_days+=("${day_iso}|${rev}|${orders}")
        chart_order_days+=("${day_iso}|${orders}|0")
        chart_session_days+=("${day_iso}|${sessions}|0")
        chart_spend_days+=("${day_iso}|$(
            if [[ -n "$spend" && "$spend" != "NULL" && "$spend" != "" ]]; then
                awk -v s="$spend" 'BEGIN { printf "%.2f", s + 0 }'
            else
                printf '0'
            fi
        )|0")
        chart_cvr_days+=("${day_iso}|$(
            if [[ -n "$cvr" && "$cvr" != "NULL" && "$cvr" != "" ]]; then
                awk -v v="$cvr" 'BEGIN { printf "%.6f", v + 0 }'
            else
                printf '0'
            fi
        )|0")
        chart_aov_days+=("${day_iso}|$(
            awk -v r="$rev" -v o="$orders" 'BEGIN {
                if (o + 0 > 0) printf "%.2f", r / o
                else print "0"
            }'
        )|0")
        chart_cos_days+=("${day_iso}|$(
            if [[ -n "$spend" && "$spend" != "NULL" && "$spend" != "" ]]; then
                awk -v s="$spend" -v r="$rev" 'BEGIN {
                    if (r + 0 > 0) printf "%.6f", s / r
                    else print "0"
                }'
            else
                printf '0'
            fi
        )|0")
        period_rev=$(awk -v a="$period_rev" -v b="$rev" 'BEGIN { printf "%.2f", a + b }')
        period_orders=$((period_orders + $(awk -v o="$orders" 'BEGIN { print int(o + 0) }')))
        period_sessions=$((period_sessions + $(awk -v s="$sessions" 'BEGIN { print int(s + 0) }')))
        period_paid=$(awk -v a="$period_paid" -v b="${paid_rev:-0}" 'BEGIN { printf "%.2f", a + b }')
        period_organic=$(awk -v a="$period_organic" -v b="${org_rev:-0}" 'BEGIN { printf "%.2f", a + b }')
        period_direct=$(awk -v a="$period_direct" -v b="${dir_rev:-0}" 'BEGIN { printf "%.2f", a + b }')
        period_email=$(awk -v a="$period_email" -v b="${email_rev:-0}" 'BEGIN { printf "%.2f", a + b }')
        if [[ -n "$spend" && "$spend" != "NULL" && "$spend" != "" ]]; then
            period_spend=$(awk -v a="$period_spend" -v b="$spend" 'BEGIN { printf "%.2f", a + b }')
        fi
    done

    prev_period_rev=0
    if (( days >= 30 )); then
        for i in $(seq 59 -1 30); do
            day_iso=$(TZ="$tz_name" date -d "${today_s} - ${i} days" +%Y-%m-%d)
            IFS='|' read -r rev orders sessions spend cvr paid_rev org_rev dir_rev email_rev <<< "$(get_day_kpi "$db_path" "$day_iso" "$spend_col")"
            prev_period_rev=$(awk -v a="$prev_period_rev" -v b="${rev:-0}" 'BEGIN { printf "%.2f", a + b }')
        done
    fi

    sym=$(currency_symbol "$(get_currency_code "$db_path" "$today_s")")

    local kpi_date="$today_s"
    IFS='|' read -r rev orders sessions spend cvr paid_rev org_rev dir_rev email_rev <<< "$(get_day_kpi "$db_path" "$today_s" "$spend_col")"
    rev=${rev:-0}
    orders=${orders:-0}
    sessions=${sessions:-0}

    if ! kpi_day_has_data "$rev" "$orders" "$sessions"; then
        local raw_rev raw_orders raw_sessions latest_date
        IFS='|' read -r raw_rev raw_orders raw_sessions <<< "$(get_raw_shopify_day "$db_path" "$today_s")"
        if kpi_day_has_data "$raw_rev" "$raw_orders" "$raw_sessions"; then
            rev="$raw_rev"
            orders="$raw_orders"
            sessions="$raw_sessions"
            spend=""
            cvr=""
            kpi_date="$today_s"
        else
            latest_date="$(get_latest_kpi_date "$db_path" "$today_s")"
            if [[ -n "$latest_date" ]]; then
                kpi_date="$latest_date"
                IFS='|' read -r rev orders sessions spend cvr paid_rev org_rev dir_rev email_rev <<< "$(get_day_kpi "$db_path" "$kpi_date" "$spend_col")"
                rev=${rev:-0}
                orders=${orders:-0}
                sessions=${sessions:-0}
            fi
        fi
    fi

    cos=""
    if [[ -n "$spend" && "$spend" != "NULL" && "$spend" != "" ]]; then
        cos=$(awk -v s="$spend" -v r="$rev" 'BEGIN {
            if (r > 0) printf "%.10f", s / r
        }')
    fi

    sparkline_json=$(build_sparkline_json "${chart_days[@]}")
    order_bars_json=$(build_sparkline_json "${chart_order_days[@]}")
    session_bars_json=$(build_sparkline_json "${chart_session_days[@]}")
    spend_bars_json=$(build_sparkline_json "${chart_spend_days[@]}")
    cvr_bars_json=$(build_sparkline_json "${chart_cvr_days[@]}")
    aov_bars_json=$(build_sparkline_json "${chart_aov_days[@]}")
    cos_bars_json=$(build_sparkline_json "${chart_cos_days[@]}")
    today_sales_val=$(format_int_commas "$(awk -v r="$rev" 'BEGIN { print int(r + 0) }')")

    if [[ -n "$cos" ]]; then
        cos_str=$(awk -v c="$cos" 'BEGIN { printf "%.1f%%", c * 100 }')
    else
        cos_str="—"
    fi

    label_text="${STORE_DISPLAY}${sym}${today_sales_val} | ${cos_str}"

    orders_n=$(awk -v o="${orders:-0}" 'BEGIN { print int(o + 0) }')
    revenue_n=$(awk -v r="${rev:-0}" 'BEGIN { printf "%.2f", r + 0 }')

    today_detail_json=$(jq -cn \
        --arg date "$kpi_date" \
        --arg calendarDate "$today_s" \
        --argjson revenue "$revenue_n" \
        --argjson orders "$orders_n" \
        --argjson sessions "$(awk -v s="$sessions" 'BEGIN { print int(s + 0) }')" \
        --arg cos "$cos_str" \
        --argjson spend "$(awk -v s="${spend:-}" 'BEGIN {
            if (s == "" || s == "NULL") print "null"
            else printf "%.2f", s + 0
        }')" \
        --argjson cvr "$(awk -v v="${cvr:-}" 'BEGIN {
            if (v == "" || v == "NULL") print "null"
            else printf "%.6f", v + 0
        }')" \
        '{
            date: $date,
            calendarDate: $calendarDate,
            revenue: $revenue,
            orders: $orders,
            sessions: $sessions,
            cos: $cos,
            spend: $spend,
            cvr: $cvr
        }')

    period_json=$(jq -cn \
        --argjson days "$days" \
        --argjson revenue "$(awk -v r="$period_rev" 'BEGIN { printf "%.2f", r + 0 }')" \
        --argjson prevRevenue "$(awk -v r="$prev_period_rev" 'BEGIN { printf "%.2f", r + 0 }')" \
        --argjson orders "$period_orders" \
        --argjson sessions "$period_sessions" \
        --argjson spend "$(awk -v s="$period_spend" 'BEGIN {
            if (s + 0 <= 0) print "null"
            else printf "%.2f", s + 0
        }')" \
        '{
            days: $days,
            revenue: $revenue,
            prevRevenue: $prevRevenue,
            orders: $orders,
            sessions: $sessions,
            spend: $spend
        }')

    channels_json=$(jq -cn \
        --argjson paid "$(awk -v v="$period_paid" 'BEGIN { printf "%.2f", v + 0 }')" \
        --argjson organic "$(awk -v v="$period_organic" 'BEGIN { printf "%.2f", v + 0 }')" \
        --argjson direct "$(awk -v v="$period_direct" 'BEGIN { printf "%.2f", v + 0 }')" \
        --argjson email "$(awk -v v="$period_email" 'BEGIN { printf "%.2f", v + 0 }')" \
        '{paid: $paid, organic: $organic, direct: $direct, email: $email}')

    day_of_month=$(TZ="$tz_name" date -d "${today_s}" +%d)
    days_in_month=$(TZ="$tz_name" date -d "${month_start} +1 month -1 day" +%d)
    mtd_revenue=$(get_month_mtd_revenue "$db_path" "$month_start" "$today_s")
    mtd_revenue=${mtd_revenue:-0}
    forecast_revenue=$(awk -v mtd="$mtd_revenue" -v day="$day_of_month" -v dim="$days_in_month" 'BEGIN {
        d = day + 0
        if (d <= 0) { print "0"; exit }
        printf "%.2f", (mtd + 0) / d * (dim + 0)
    }')

    month_json=$(jq -cn \
        --argjson mtdRevenue "$(awk -v r="$mtd_revenue" 'BEGIN { printf "%.2f", r + 0 }')" \
        --argjson forecastRevenue "$forecast_revenue" \
        --argjson day "$day_of_month" \
        --argjson daysInMonth "$days_in_month" \
        '{
            mtdRevenue: $mtdRevenue,
            forecastRevenue: $forecastRevenue,
            day: $day,
            daysInMonth: $daysInMonth
        }')

    output=$(json_shopify "$label_text" "$label_text" "$sparkline_json" "$sym" \
        "$orders_n" "$cos_str" "$revenue_n" "$today_detail_json" "$period_json" \
        "$channels_json" "$order_bars_json" "$month_json" \
        "$session_bars_json" "$spend_bars_json" "$cvr_bars_json" "$aov_bars_json" "$cos_bars_json")
    printf '%s\n' "$output"
}

main() {
    local store_prefix=${1:-}
    local days=${2:-14}
    local cache_key cached output

    if ! [[ "$days" =~ ^[0-9]+$ ]] || (( days < 1 )); then
        days=14
    fi
    if (( days > 90 )); then
        days=90
    fi
    cache_key="$(store_cache_key "${store_prefix:-all}" "$days")"

    if cached=$(evo_bar_cache_read_any "$cache_key" 2>/dev/null) && payload_is_ok "$cached"; then
        printf '%s\n' "$cached"
        return 0
    fi

    load_shopify_config
    evo_bar_load_heatmap_colors
    output=$(build_one_store "$store_prefix" "$days") || return 1
    printf '%s\n' "$output" | evo_bar_cache_write "$cache_key"
    printf '%s\n' "$output"
}

cmd_stores() {
    local cached
    if cached=$(evo_bar_cache_read_any "$(snapshot_cache_key)" 2>/dev/null); then
        jq -c '.stores // []' <<<"$cached"
        return 0
    fi
    printf '[]\n'
}

cmd_demo() {
    local path="${_bin_dir}/../demo.json"
    local icon
    path=$(cd "${_bin_dir}/.." && pwd)/demo.json
    icon=$(cd "${_bin_dir}/.." && pwd)/assets/shopify-logo.svg
    if [[ ! -f "$path" ]]; then
        printf '%s\n' "$EMPTY_SNAPSHOT"
        return 1
    fi
    if [[ ! -f "$icon" ]]; then
        cat "$path"
        return 0
    fi
    jq -c --arg icon "$icon" '.stores |= map(.iconPath = $icon)' "$path"
}

case "${1:-}" in
    cache)
        cmd_cache
        ;;
    demo)
        cmd_demo
        ;;
    refresh)
        cmd_refresh
        ;;
    stores)
        cmd_stores
        ;;
    *)
        main "$@"
        ;;
esac
